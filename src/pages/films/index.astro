---
import Layout from '../../layouts/Layout.astro';
import { getAllFilms } from '../../content/films/loader';
import FilmThumbnail from '../../components/FilmThumbnail';

const films = getAllFilms();
---

<Layout title="films" currentPath="/films">
  <div class="flex-grow overflow-y-auto p-8 custom-scrollbar">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-1">
      {films.map((film) => (
        <a href={`/films/${film.slug}`} class="tui-border bg-[#1a1a1a] hover:bg-[#201f1f] transition-all group overflow-hidden block">
          <div class="h-8 flex items-center justify-between px-3 bg-emerald-900/10 border-b border-emerald-900/20">
            <span class="font-label-mono text-[10px] text-secondary tracking-tighter uppercase">[ PID: {film.slug.slice(0,3).toUpperCase()} ]</span>
            <span class="font-label-mono text-[10px] text-on-surface-variant opacity-50">{film.year || film.date}</span>
          </div>
          <div class="aspect-video relative overflow-hidden bg-black">
            <FilmThumbnail client:load stills={film.stills.filter(s => s.split('/').pop()?.startsWith('4085'))} alt={film.title} thumbnail={film.thumbnail} />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent pointer-events-none"></div>
            <div class="absolute bottom-4 left-4">
              <h3 class="font-headline-md text-lg text-white lowercase">{film.title}</h3>
            </div>
          </div>
          <div class="p-4 space-y-4">
            <div class="flex flex-wrap gap-2">
              <span class={`text-[10px] font-label-mono border px-2 py-0.5 lowercase ${film.status === 'live' ? 'border-primary text-primary' : film.status === 'processing' ? 'border-yellow-500 text-yellow-500' : 'border-secondary text-secondary'}`}>
                [{film.status || 'archived'}]
              </span>
              {film.format && (
                <span class="text-[10px] font-label-mono border border-outline-variant text-on-surface-variant px-2 py-0.5 lowercase">{film.format}</span>
              )}
              {film.fps && (
                <span class="text-[10px] font-label-mono border border-outline-variant text-on-surface-variant px-2 py-0.5 lowercase">{film.fps}</span>
              )}
            </div>
            <div class="flex justify-between items-center text-[10px] font-label-mono text-on-surface-variant/40">
              <span>duration: {film.duration || film.runtime}</span>
              <span class="group-hover:text-secondary transition-colors">[ view ]</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout>