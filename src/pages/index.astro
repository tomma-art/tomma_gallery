---
import '../styles/global.css';
import ShaderBg from '../components/ShaderBg';
import { ClientRouter } from 'astro:transitions';
---

<!DOCTYPE html>
<html class="dark bg-[#131313]" lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Doto:wght@300;400;500;700&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500;700&display=swap" rel="stylesheet" />
  <title>tomma</title>
  <ClientRouter />
</head>
<body class="font-body-reg text-on-surface selection:bg-secondary selection:text-on-secondary overflow-hidden h-screen bg-[#131313]">
  <ShaderBg client:load />

  <div class="h-full relative flex flex-col items-center justify-center px-6">
    <div class="text-center">
      <h1 class="font-display text-[20vw] md:text-[12vw] font-bold text-white/90 tracking-tighter leading-none mb-6">
        tomma
      </h1>
      <div class="flex flex-col items-center gap-2 mb-16">
        <span class="font-mono text-[10px] md:text-xs text-white/40 tracking-[0.3em] uppercase">
          filmmaker / visual designer
        </span>
        <span class="font-mono text-[10px] text-white/20 tracking-[0.3em] uppercase">
          Tom Maher
        </span>
      </div>
      <a 
        href="/home" 
        class="group inline-flex items-center gap-3 font-mono text-xs text-white/40 hover:text-white/80 tracking-[0.25em] uppercase transition-all duration-500"
      >
        <span class="w-8 h-px bg-white/20 group-hover:w-12 group-hover:bg-white/60 transition-all duration-500" />
        <span>enter</span>
        <span class="w-8 h-px bg-white/20 group-hover:w-12 group-hover:bg-white/60 transition-all duration-500" />
      </a>
    </div>

    <div class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-white/15">
      <span class="font-mono text-[8px] tracking-[0.3em] uppercase">view work</span>
      <div class="w-px h-6 bg-white/15" />
    </div>
  </div>
</body>
</html>