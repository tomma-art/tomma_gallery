---
import Layout from '../layouts/Layout.astro';
---

<Layout title="home" currentPath="/">
  <header class="h-16 flex items-center justify-between px-8 border-b border-outline-variant/30">
    <div class="flex items-center space-x-4 font-label-mono text-[11px] tracking-widest text-on-surface-variant">
      <span class="text-secondary">[ root ]</span>
      <span class="opacity-30">/</span>
      <span>home</span>
      <span class="opacity-30">/</span>
      <span class="text-primary-fixed-dim">shell.sh</span>
    </div>
    <div class="flex items-center space-x-6">
      <div class="flex space-x-1">
        <span class="w-2 h-2 rounded-full bg-error/40"></span>
        <span class="w-2 h-2 rounded-full bg-secondary/40"></span>
        <span class="w-2 h-2 rounded-full bg-primary/40"></span>
      </div>
    </div>
  </header>
  
  <div class="flex-grow overflow-y-auto p-8 custom-scrollbar flex items-center justify-center">
    <div class="w-full max-w-4xl">
      <div class="mb-12 border-l-2 border-secondary pl-6">
        <h2 class="font-display-lg text-2xl text-primary lowercase mb-2"> Who is tomma?</h2>
        <p class="font-body-reg text-sm text-on-surface-variant max-w-2xl">
          tomma is Tom Maher
        </p>
      </div>
      
      <div class="tui-border bg-[#1a1a1a] overflow-hidden">
        <div class="h-8 flex items-center justify-between px-3 bg-emerald-900/10 border-b border-emerald-900/20">
          <span class="font-label-mono text-[10px] text-secondary tracking-tighter uppercase">[ VIDEO_REEL ]</span>
          <span class="font-label-mono text-[10px] text-on-surface-variant opacity-50">ready</span>
        </div>
        <div class="aspect-video relative bg-black">
          <iframe 
            class="w-full h-full absolute inset-0"
            src="https://player.vimeo.com/video/349586952?title=0&byline=0&portrait=0&autoplay=0&loop=1&muted=0"
            frameborder="0"
            allow="autoplay; fullscreen; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
        <div class="p-4 flex items-center justify-between border-t border-emerald-900/20">
          <span class="font-label-mono text-[10px] text-on-surface-variant/40">encoder: html5</span>
          <span class="font-label-mono text-[10px] text-secondary">[ execute ]</span>
        </div>
      </div>
    </div>
  </div>
</Layout>