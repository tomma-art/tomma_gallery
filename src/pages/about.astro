---
import Layout from '../layouts/Layout.astro';
import { getPage } from '../content/pages/loader';

const page = getPage('about') || {
  title: 'About',
  bio: '',
  location: '',
  socials: [],
  brands: [],
  content: ''
};

const socialIcons: Record<string, string> = {
  email: 'email',
  instagram: 'chat',
  vimeo: 'movie',
  linkedin: 'work',
  website: 'language'
};
---

<Layout title="about" currentPath="/about">
  <div class="flex-grow overflow-y-auto p-4 md:p-8 custom-scrollbar">
    <div class="max-w-4xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-12">
        <div class="tui-border bg-[#1a1a1a] lg:col-span-1">
          <div class="aspect-square relative overflow-hidden bg-[#0e0e0e]">
            {page.portrait ? (
              <img 
                class="w-full h-full object-cover opacity-80" 
                src={page.portrait}
                alt={page.title}
              />
            ) : (
              <div class="w-full h-full flex items-center justify-center">
                <span class="material-symbols-outlined text-6xl text-emerald-100/20">person</span>
              </div>
            )}
          </div>
          <div class="p-4 border-t border-emerald-900/20">
            <div class="space-y-2">
              {page.socials?.map((social) => (
                <a 
                  href={social.link} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="flex items-center space-x-2 text-sm text-emerald-100/70 hover:text-emerald-50 transition-colors"
                >
                  <span class="material-symbols-outlined text-lg">{socialIcons[social.name] || 'link'}</span>
                  <span class="lowercase">{social.name}</span>
                </a>
              ))}
            </div>
          </div>
        </div>
        
        <div class="lg:col-span-2 space-y-6">
          <div>
            <h3 class="font-display-lg text-xl text-white mb-2">{page.title}</h3>
            <p class="font-body-reg text-on-surface-variant">{page.bio}</p>
          </div>
          
          <div class="tui-border bg-[#1a1a1a] p-4">
            <h2 class="font-label-mono text-[10px] text-secondary uppercase mb-3">[ bio ]</h2>
            <p class="font-body-reg text-on-surface-variant text-sm leading-relaxed whitespace-pre-line">
              {page.content}
            </p>
          </div>
          
          {page.location && (
            <div class="flex items-center space-x-2 text-sm text-on-surface-variant">
              <span class="material-symbols-outlined text-lg">location_on</span>
              <span>{page.location}</span>
            </div>
          )}
        </div>
      </div>
      
      {page.brands && page.brands.length > 0 && (
      <div class="tui-border bg-[#1a1a1a] p-6">
        <h2 class="font-label-mono text-[10px] text-secondary uppercase mb-4">[ clients ]</h2>
        <div class="flex flex-wrap gap-4">
          {page.brands.map((brand: string) => (
            <span class="text-sm text-on-surface-variant/60 border border-emerald-900/30 px-3 py-1">
              {brand}
            </span>
          ))}
        </div>
      </div>
      )}

      {page.spotifyPlaylist && (
      <div class="tui-border bg-[#1a1a1a] p-6 mt-6">
        <h2 class="font-label-mono text-[10px] text-secondary uppercase mb-4">[ playlist ]</h2>
        <iframe 
          style="border-radius: 12px" 
          src={`https://open.spotify.com/embed/playlist/${page.spotifyPlaylist}?utm_source=generator&theme=0`}
          width="100%" 
          height="380" 
          frameBorder="0" 
          allowfullscreen="" 
          allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" 
          loading="lazy">
        </iframe>
      </div>
      )}
    </div>
  </div>
</Layout>