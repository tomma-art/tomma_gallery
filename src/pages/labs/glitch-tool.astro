---
import Layout from '../../layouts/Layout.astro';
import GlitchTool from '../../components/GlitchTool';
---

<Layout title="glitch tool" currentPath="/labs">
  <div class="flex flex-col h-full">
    <div class="flex-1 flex flex-col">
      <!-- Title bar -->
      <div class="bg-[#1a1a1a] border border-[#333] border-b-0 px-4 py-2 flex items-center justify-between shrink-0">
        <div class="flex items-center gap-2">
          <span class="text-green-400">●</span>
          <span class="text-green-400">●</span>
          <span class="text-green-400">●</span>
        </div>
        <div class="text-green-400/50 font-mono text-xs">
          GLITCH_TOOL v1.0
        </div>
        <div class="w-12"></div>
      </div>
      
      <!-- Glitch Tool -->
      <div class="border-2 border-[#333] border-t-0 bg-black overflow-hidden shadow-2xl flex-1">
        <GlitchTool client:load />
      </div>
    </div>
  </div>
</Layout>

<style>
  :global(body) {
    background: #0a0a0a;
  }
</style>